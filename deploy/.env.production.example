# Copy this file to .env.production, replace every placeholder, then chmod 600 it.
# Never commit .env.production.
# Percent-encode special characters in the MariaDB user and password.
# mariadb-shared is resolved through the external db-tier Docker network.
DATABASE_URL=mysql://CESIZEN_USER:REPLACE_WITH_PASSWORD@mariadb-shared:3306/CESIZEN_DB
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=https://cesizen.example.org

# Optional GLPI support integration. Leave every value empty to disable it,
# or configure the complete block with the internal GLPI API endpoint.
GLPI_API_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_TIMEOUT_MS=
GLPI_CATEGORY_ACCOUNT_ID=
GLPI_CATEGORY_TECHNICAL_ID=
GLPI_CATEGORY_USAGE_ID=
GLPI_CATEGORY_PRIVACY_ID=
GLPI_CATEGORY_OTHER_ID=

MOBILE_ALLOWED_ORIGINS=https://mobile.cesizen.example.org
MOBILE_DEV_HOST=
NODE_ENV=production
