# Full GHCR reference. Prefer an immutable digest or commit tag in CI.
CESIZEN_IMAGE=ghcr.io/your-organization/cesizen:replace-with-immutable-tag

# Existing Docker network also used by Nginx Proxy Manager.
NPM_NETWORK=nginx-proxy-manager_default

# Existing maintenance container reachable from the NPM network.
MAINTENANCE_CONTAINER=maintenance-web
MAINTENANCE_PORT=80

# Non-secret deployment settings.
COMPOSE_PROJECT_NAME=cesizen
NGINX_IMAGE=nginx:1.30.4-alpine
DEPLOY_HEALTH_TIMEOUT=150
DEPLOY_HEALTH_INTERVAL=3
INFRA_HEALTH_TIMEOUT=60
