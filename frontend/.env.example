# Prisma utilise mysql:// pour MariaDB. Encoder en pourcentage les caracteres
# speciaux du nom d'utilisateur et du mot de passe (par exemple @ devient %40).
DATABASE_URL="mysql://cesizen_user:cesizen_password@localhost:3306/cesizen_db"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Integration GLPI facultative. Laisser toutes ces valeurs vides pour la
# desactiver, ou renseigner l'ensemble avec les IDs des categories GLPI.
GLPI_API_URL=""
GLPI_APP_TOKEN=""
GLPI_USER_TOKEN=""
GLPI_TIMEOUT_MS=""
GLPI_CATEGORY_ACCOUNT_ID=""
GLPI_CATEGORY_TECHNICAL_ID=""
GLPI_CATEGORY_USAGE_ID=""
GLPI_CATEGORY_PRIVACY_ID=""
GLPI_CATEGORY_OTHER_ID=""

# Origins web autorisees a appeler les routes /api/mobile avec des cookies.
MOBILE_ALLOWED_ORIGINS="http://localhost:8081"

# Adresse LAN optionnelle utilisee pour Expo pendant le developpement.
MOBILE_DEV_HOST=""
